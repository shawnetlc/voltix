import 'package:json_annotation/json_annotation.dart';

part 'seerr_models.g.dart';

class VoltixProxyConfig {
  final String jellyfinBaseUrl;
  final String jellyfinToken;

  const VoltixProxyConfig({
    required this.jellyfinBaseUrl,
    required this.jellyfinToken,
  });
}

@JsonSerializable()
class VoltixStatusResponse {
  final bool enabled;
  final bool authenticated;
  final String? url;
  final int? jellyseerrUserId;
  final String? displayName;
  final String? avatar;
  final int permissions;
  final int? sessionCreated;
  final int? lastValidated;

  const VoltixStatusResponse({
    this.enabled = false,
    this.authenticated = false,
    this.url,
    this.jellyseerrUserId,
    this.displayName,
    this.avatar,
    this.permissions = 0,
    this.sessionCreated,
    this.lastValidated,
  });

  factory VoltixStatusResponse.fromJson(Map<String, dynamic> json) =>
      _$VoltixStatusResponseFromJson(json);

  Map<String, dynamic> toJson() => _$VoltixStatusResponseToJson(this);
}

